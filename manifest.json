{
  "name": "Conga Debugger",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": { 
    "default_title": "Conga Debugger",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "debugger", "storage"],
  "host_permissions": ["<all_urls>"],
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    { "resources": ["panel.html", "panel.js"], "matches": ["<all_urls>"] }
  ]
}
